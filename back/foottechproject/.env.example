NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=foottech
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_SCHEMA=platform
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20

