NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=foottech
DB_USER=postgres
DB_PASSWORD=fares
DB_SCHEMA=platform
DB_SSL=false
DB_POOL_MAX=20

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=*

UPLOAD_DIR=src/uploads
MAX_UPLOAD_MB=20

BCRYPT_SALT_ROUNDS=12

OTP_LENGTH=6
OTP_EXPIRES_MIN=10

# SMS OTP provider legacy key (unused in code — Twilio is the active channel).
SMS_PROVIDER_API_KEY=

# ─── Redis (optional cache) ──────────────────────────────────
# Leave empty to disable caching.
REDIS_URL=redis://localhost:6379

# ─── Twilio SMS OTP (optional) ───────────────────────────────
# Leave unset in dev — verification codes are logged instead of being sent.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ─── Firebase Push Notifications (optional) ──────────────────
# Leave unset in dev — push notifications are logged instead of being sent.
# FIREBASE_PROJECT_ID=foottech-xxxxx
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@foottech-xxxxx.iam.gserviceaccount.com

# ─── AI Microservices ─────────────────────────────────────────
# lineup-recommendation-service (FastAPI, port 8100) — called by POST
# /api/v1/matches/:id/ai-recommendations to score the starting XI.
LINEUP_SERVICE_URL=http://localhost:8100
# Timeout per lineup call (ms). Requests never block beyond this window.
LINEUP_SERVICE_TIMEOUT_MS=5000
# ai-insights-service (FastAPI, port 8300) — consumed by Flutter analytics.
AI_INSIGHTS_SERVICE_URL=http://localhost:8300
