@startuml
title FootTech - Backend Admin (Django + DRF) : Modules
caption Application Django du back-office de la plateforme : administrateurs, core, moderation

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing true
skinparam ArrowColor #333333

' ============================================================================
' STEREOTYPES / COULEURS (BLEU clair = Django)
' ============================================================================
skinparam package {
    BackgroundColor #E1F5FE
    BorderColor #0288D1
    FontColor #01579B
}

skinparam package<<Admin>> {
    BackgroundColor #E8EAF6
    BorderColor #3949AB
    FontColor #1A237E
}

skinparam class {
    BackgroundColor #F5F8FF
    BorderColor #0288D1
    FontColor #014
}
skinparam classHeaderBackgroundColor #42A5F5
skinparam classHeaderFontColor #FFFFFF

skinparam database {
    BackgroundColor #ECEFF1
    BorderColor #37474F
    FontColor #263238
}

' ============================================================================
' PROJET DJANGO (racine)
' ============================================================================
package "foottech_admin (settings/settings.py)" {
    class "settings.py" {
        + INSTALLED_APPS = [administrateurs, core, moderation]
        + AUTH_USER_MODEL = administrateurs.Administrateur
        + DATABASES = postgres (même base que Express)
        + OPTIONS options : -c search_path=public,platform
        + REST_FRAMEWORK (JWT + pagination)
        + SIMPLE_JWT (access 30min / refresh 7j)
    }
    class "urls.py" {
        /admin-site/
        /api/admin/auth/
        /api/admin/
    }
    class "manage.py"
}

' ============================================================================
' APP : administrateurs (auth & gestion des admins)
' ============================================================================
package "administrateurs (comptes et authentification)" as APP_ADMIN <<Admin>> {
    class "Administrateur\n(AbstractBaseUser)" {
        + nom / prenom
        + email (unique)
        + role : SUPER_ADMIN | MODERATEUR | SUPPORT
        + is_staff / is_active
        + has_full_access()
    }
    class "AdministrateurManager" {
        + create_user()
        + create_superuser()
    }
    class "permissions.py" {
        + IsSuperAdmin
    }
    class "serializers.py" {
        + AdminTokenObtainPairSerializer
        + AdministrateurSerializer
        + CreateAdministrateurSerializer
    }

    class "views.py (DRF)" {
        + AdminLoginView  (POST /auth/login)
        + MeView          (GET/PATCH /auth/me)
        + ChangePasswordView
        + AdministrateurListCreateView
        + UserStatisticsView
        + PlatformOverviewView
    }

    class "urls.py" {
        + /api/admin/auth/*
    }

    class "admin.py\n(interface Django admin)" {
        + enregistrement du modèle
    }

    AdministrateurManager ..> Administrateur : "crée des instances"
    views.py <.. serializers.py : "utilise"
    views.py <.. permissions.py : "contrôle d'accès"
    urls.py --> views.py : "route"
    admin.py --> Administrateur : "inscrit"
}

' ============================================================================
' APP : core (miroir en lecture des tables Express)
' ============================================================================
package "core (miroir lecture des tables Express, managed=False)" {
    class "Utilisateur" {
        + id_utilisateur (PK, col: id)
        + nom / prenom / email / telephone
        + date_creation
        + account_status
        + role (propriété : user_roles → roles)
        + actif (propriété : account_status == 'ACTIVE')
        - db_table = users
    }
    class "Role" {
        + id / name
        - db_table = roles
    }
    class "RoleJointure" {
        + user_id / role_id
        - db_table = user_roles
    }
    class "Equipe" {
        + id_equipe (col: id) / nom_equipe (col: name)
        + categorie (col: category)
        + id_coach (FK Utilisateur, col: coach_id)
        - db_table = teams
    }
    class "Joueur" {
        + id_utilisateur (1-1 FK, PK col: id)
        + id_equipe (col: team_id) / poste (col: poste_principal)
        - db_table = players
    }
    class "Adjoint" {
        + id_adjoint
        + id_equipe (col: team_id) / id_utilisateur (col: adjoint_id)
        - db_table = team_staff
    }
    class "Entrainement" {
        + id_entrainement / id_equipe (col: team_id)
        + date_seance (col: date) / statut (col: status)
        - db_table = trainings
    }
    class "Match" {
        + id_match / id_equipe / adversaire / date_match
        + score_domicile / score_exterieur
        + statut (col: match_status)
        - db_table = matches
    }
    class "Notification" {
        + id_notification / id_utilisateur (col: user_id)
        + type_notification (col: type) / message / lu (col: is_read)
        - db_table = notifications
    }
    class "migrations" {
        + 0001_add_admin_columns.py (vues legacy additives)
        + 0002_initial.py (CreateModel des modèles, managed=False)
    }

    Utilisateur "1" ..> "0..*" Equipe : "coache"
    RoleJointure "*" --> Utilisateur : "user_id"
    RoleJointure "*" --> Role : "role_id"
    Equipe "1" ..> "0..*" Joueur
    Equipe "1" ..> "0..*" Adjoint
    Utilisateur "1" ..> "0..*" Entrainement
    Utilisateur "1" ..> "0..*" Notification
}

' ============================================================================
' APP : moderation (journal d'audit + diffusion)
' ============================================================================
package "moderation (audit & diffusion)" {
    class "AuditLog" {
        + action : SUSPEND_TEAM | ACTIVATE_TEAM | SUSPEND_USER | ACTIVATE_USER | BROADCAST_NOTIFICATION
        + administrateur (FK)
        + cible_type / cible_id
        + details (JSON)
        + date_action
        - db_table = admin_audit_log
    }
    class "views.py (DRF)" {
        + BroadcastNotificationView
        + AuditLogListView
        + SuspendTeamView / ActivateTeamView
        + SuspendUserView / ActivateUserView
    }
    class "serializers.py" {
        + BroadcastSerializer
        + AuditLogSerializer
    }
    class "urls.py" {
        + /teams/:id_equipe/suspend/
        + /users/:id_utilisateur/suspend/
        + /notifications/broadcast/
        + /audit-logs/
    }
    class "admin.py"

    views.py <.. serializers.py : "utilise"
    urls.py --> views.py : "route"
    views.py ..> AuditLog : "enregistre chaque action"
    admin.py --> AuditLog : "inscrit"

    AuditLog ..> Administrateur : "auteur de l'action (FK settings.AUTH_USER_MODEL)"
}

' ============================================================================
' BASE DE DONNÉES
' ============================================================================
database "PostgreSQL (foottech)" as PG

' settings.py ..> PG : "connexion (search_path=public,platform)"
' core --> PG : "lecture seule (managed=False, miroir)"
' moderation --> PG : "écrit journal + diffuse"
' administrateurs --> PG : "AUTH_USER_MODEL + login"

' ============================================================================
' NOTE
' ============================================================================
note bottom
  Tous les modèles de l'app core sont en mode non géré (managed=False) :
  ils reflètent les tables anglaises déjà créées par le backend Express
  (users, teams, players, team_staff, trainings, matches, notifications,
  roles, user_roles) et servent uniquement à la lecture / supervision.
  « actif » n'est pas une colonne : c'est une propriété Python calculée
  depuis account_status. Seules les tables admin (administrateur,
  admin_audit_log) sont gérées par Django.

  Tables de la base : tables Express (users, teams, players, team_staff,
  trainings, matches, notifications) et tables admin (administrateur,
  admin_audit_log).
end note

@enduml