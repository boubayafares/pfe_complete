@startuml
title FootTech — Activité — Épopée 10 : Statistiques et performances
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam roundcorner 10

skinparam ActivityBackgroundColor #E8F5E9
skinparam ActivityBorderColor #2E7D32
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam ActivityDiamondBorderColor #F57F17
start
:Ouvrir le module;
:Vérifier la session, le rôle et l'équipe active;
if (Accès autorisé ?) then (oui)
  :Choisir la User Story;
  switch (Fonction sélectionnée)
  case (US-43)
    :Consulter ses statistiques personnelles\nGET /dashboard/me;
    :Indicateurs personnels affichés;
  case (US-44)
    :Consulter les statistiques de l'équipe\nGET /dashboard/season-bilan;
    :Agrégats d'équipe affichés;
  case (US-45)
    :Comparer les performances des joueurs\nGET /dashboard/season-bilan?players=...;
    :Comparaison affichée;
  case (US-46)
    :Consulter l'évolution saisonnière d'un joueur\nGET /players/:id/season-profile;
    :Courbe d'évolution affichée;
  endswitch
  :Actualiser l'état Riverpod / interface;
else (non)
  :Afficher 401 ou 403;
endif
if (Erreur métier ou technique ?) then (oui)
  :Normaliser l'erreur et proposer une reprise;
else (non)
  :Confirmer l'opération;
endif
stop
@enduml
