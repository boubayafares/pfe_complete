@startuml
title FootTech — Activité — Épopée 13 : AI Insights
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam roundcorner 10

skinparam ActivityBackgroundColor #E8F5E9
skinparam ActivityBorderColor #2E7D32
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam ActivityDiamondBorderColor #F57F17
start
:Ouvrir le module;
:Vérifier la session, le rôle et l'équipe active;
if (Accès autorisé ?) then (oui)
  :Choisir la User Story;
  switch (Fonction sélectionnée)
  case (US-55)
    :Détecter la tendance d'un joueur\nPOST /api/v1/trend/detect;
    :Tendance et R² calculés;
  case (US-56)
    :Regrouper les joueurs par profils\nPOST /api/v1/clustering/players;
    :Clusters calculés;
  case (US-57)
    :Analyser le ton d'un commentaire\nPOST /api/v1/tone/analyze;
    :Classe et suggestion retournées;
  case (US-58)
    :Transcrire une observation vocale\nPOST /api/v1/transcription;
    :Texte et confiance retournés;
  case (US-59)
    :Extraire les champs d'un document\nPOST /api/v1/documents/extract;
    :Champs OCR structurés;
  endswitch
  :Actualiser l'état Riverpod / interface;
else (non)
  :Afficher 401 ou 403;
endif
if (Erreur métier ou technique ?) then (oui)
  :Normaliser l'erreur et proposer une reprise;
else (non)
  :Confirmer l'opération;
endif
stop
@enduml
