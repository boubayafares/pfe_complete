@startuml
title FootTech — Activité — Épopée 6 : Gestion des présences
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ArrowColor #455A64
skinparam packageStyle rectangle
skinparam roundcorner 10

skinparam ActivityBackgroundColor #E8F5E9
skinparam ActivityBorderColor #2E7D32
skinparam ActivityDiamondBackgroundColor #FFF8E1
skinparam ActivityDiamondBorderColor #F57F17
start
:Ouvrir le module;
:Vérifier la session, le rôle et l'équipe active;
if (Accès autorisé ?) then (oui)
  :Choisir la User Story;
  switch (Fonction sélectionnée)
  case (US-27)
    :Marquer la présence d'un joueur\nPOST /attendance/trainings/:id;
    :Présence enregistrée;
  case (US-28)
    :Marquer les présences en lot\nPOST /attendance/trainings/:id/bulk;
    :Lot validé atomiquement;
  case (US-29)
    :Consulter les présences d'un entraînement\nGET /attendance/trainings/:id;
    :Feuille de présence affichée;
  case (US-30)
    :Consulter l'historique d'un joueur\nGET /attendance/players/:id;
    :Historique filtré affiché;
  endswitch
  :Actualiser l'état Riverpod / interface;
else (non)
  :Afficher 401 ou 403;
endif
if (Erreur métier ou technique ?) then (oui)
  :Normaliser l'erreur et proposer une reprise;
else (non)
  :Confirmer l'opération;
endif
stop
@enduml
