@startuml
!pragma layout smetana
title FootTech - Diagramme de Flux de Données (Data Flow Diagram)
caption Parcours des données à travers le système : de la saisie mobile jusqu'aux services IA et au stockage

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam shadowing true
skinparam ArrowColor #333333

' ============================================================================
' COULEURS PAR COUCHE
' ============================================================================
skinparam actor {
    BackgroundColor #FAFAFA
}
skinparam component {
    BackgroundColor #EEEEEE
    BorderColor #616161
}
skinparam component<<Frontend>> {
    BackgroundColor #2E8B57
    BorderColor #1F5C3D
    FontColor #FFFFFF
}
skinparam component<<Backend>> {
    BackgroundColor #1E88E5
    BorderColor #0D47A1
    FontColor #FFFFFF
}
skinparam component<<AI>> {
    BackgroundColor #F57C00
    BorderColor #E65100
    FontColor #FFFFFF
}
skinparam component<<External>> {
    BackgroundColor #E53935
    BorderColor #B71C1C
    FontColor #FFFFFF
}
skinparam database {
    BackgroundColor #607D8B
    BorderColor #37474F
    FontColor #FFFFFF
}

' ============================================================================
' ACTEURS EXTERNES
' ============================================================================
actor "Utilisateurs\n(Coach / Adjoint / Joueur)" as USERS
actor "Admin\n(plateforme)" as ADMIN

' ============================================================================
' COUCHE PRÉSENTATION (FRONTEND)
' ============================================================================
component "Flutter App\n(écrans + Riverpod)" as FLUTTER <<Frontend>>
component "JavaFX Desktop\n(Admin)" as JAVAFX <<Frontend>>

' ============================================================================
' COUCHE APPLICATION (BACKEND)
' ============================================================================
component "Express API\n(port 4000)" as EXPRESS <<Backend>>
component "Django + DRF\n(port 8000)" as DJANGO <<Backend>>
component "Socket.io\nServer" as SOCKET <<Backend>>

' ============================================================================
' SERVICES IA / EXTERNES
' ============================================================================
component "AI Insights\n(:8300)" as AI <<AI>>
component "Lineup Service\n(:8100)" as RECO <<AI>>
component "Firebase\npush" as FCM <<External>>
component "Twilio\n(SMS/OTP)" as TWILIO <<External>>

' ============================================================================
' STOCKAGE
' ============================================================================
database "Redis\n(initialise, inutilise)" as REDIS
database "PostgreSQL\n(platform)" as PG
database "Stockage local\n(SharedPrefs / secure)" as LOCALDB

' ============================================================================
' FLUX DE DONNÉES
' ============================================================================

' 1) Entrée utilisateur -> Frontend
USERS -> FLUTTER : "saisie (données structurées)"
USERS -> FLUTTER : "requêtes"

' 2) Frontend -> API
FLUTTER -> EXPRESS : "REST + JWT (Dio)"
FLUTTER -> SOCKET : "WebSocket (live events)"
FLUTTER -> AI : "appel direct hors Express\n(tendances / clustering / ton)"

' 3) API -> donnees
EXPRESS -> PG : "CRUD / requetes SQL"

' 4) Orchestration du scoring d'alignement
EXPRESS -> RECO : "POST /api/v1/lineup/recommendations\n(donnees + poids dans la requete)"

' 5) Persistance
EXPRESS -> PG : "persiste ai_lineup_recommendations"

' 6) Notifications
EXPRESS -> FCM : "push payload (tokens)"
EXPRESS -> TWILIO : "SMS OTP"
EXPRESS -> SOCKET : "diffusion temps reel"
SOCKET -> FLUTTER : "evenements temps reel"
FCM -> FLUTTER : "push notification"
TWILIO -> USERS : "SMS recu"

' 7) Donnees locales device
FLUTTER -> LOCALDB : "JWT + preferences (persistance locale)"

' 8) Admin desktop + back-office
ADMIN -> JAVAFX : "actions admin"
JAVAFX -> DJANGO : "REST + JWT"
DJANGO -> PG : "CRUD administre (moderation, audit)"

' ============================================================================
' INVERSES / TELECHARGEMENT
' ============================================================================
EXPRESS --> FLUTTER : "reponses (JSON) + erreurs"
FLUTTER --> USERS : "affichage / feedback"
PG --> EXPRESS : "resultats de requetes"

' ============================================================================
' NOTE SUR LE FLUX TYPE
' ============================================================================
note right of EXPRESS
  Flux type d'un match live :\n
  1. Adjoint saisit un evenement\n
  2. Express valide + ecrit dans PostgreSQL\n
  3. Socket.io diffuse a toute l'equipe\n
  4. Express demande l'alignement au Lineup Service\n
     (calcul pur, donnees passees dans la requete)\n
  5. Aucun cache Redis n'est reellement utilise ;
     ai-insights-service est appele directement par l'app.
end note

@enduml
