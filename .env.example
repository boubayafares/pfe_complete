# ─── Database ──────────────────────────────────────────────
DB_PASSWORD=replace-with-a-strong-database-password

# Local development only. Never set OTP_DEV_CODE in production.
NODE_ENV=production
OTP_DEV_CODE=

# ─── JWT Secrets (min 32 chars) ────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters

# ─── Service-to-service authentication ────────────────────
AI_SERVICE_TOKEN=your-ai-service-token-minimum-32-characters

# ─── Twilio SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Firebase Push Notifications ───────────────────────────
FIREBASE_PROJECT_ID=foottech-xxxxx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@foottech-xxxxx.iam.gserviceaccount.com

# ─── Django Admin ──────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-random-django-secret-key-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,admin-api
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# Bind localhost by default. Use 0.0.0.0 explicitly only when a LAN client needs access.
API_BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1

# ─── AI Microservices ───────────────────────────────────────
LINEUP_SERVICE_URL=http://localhost:8100
LINEUP_SERVICE_TIMEOUT_MS=5000
AI_INSIGHTS_SERVICE_URL=http://localhost:8300
AI_INSIGHTS_SERVICE_TIMEOUT_MS=5000
